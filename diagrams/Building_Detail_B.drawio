    <!-- Survivability Box -->
    <mxCell id="survivability" value="⚡ SURVIVABILITY – Building B&#xa;─────────────────────────────────────────&#xa;NORMAL (Fiber UP):&#xa;• All 500 IP phones register to IP Office Server (Bldg A)&#xa;• All calls processed by primary server&#xa;• STC SIP trunk via Building A SBCE&#xa;─────────────────────────────────────────&#xa;FALLBACK (Fiber DOWN):&#xa;• IP phones detect loss of registration&#xa;• Phones re-register to IP500 V2 #2 (local)&#xa;• Internal Building B calls maintained&#xa;• Analog extensions (IP500 V2 #2) unaffected&#xa;• STC SIP trunk unavailable (Bldg A only)&#xa;• Recommend: PSTN backup line to IP500 V2 #2&#xa;─────────────────────────────────────────&#xa;RESTORE (Fiber restored):&#xa;• Phones auto-register back to primary server&#xa;• Full functionality resumes automatically" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=10;fontStyle=0;align=left;spacingLeft=8;" vertex="1" parent="bldg_b">
